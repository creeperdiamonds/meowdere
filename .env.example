# Copy to .env and fill in. Never commit .env.

# Discord Developer Portal → your app → Bot → Reset Token
DISCORD_TOKEN=

# Your Discord user ID (Developer Mode on → right-click yourself → Copy User ID)
OWNER_ID=

# A GitHub token that can read the repos and their Actions runs.
# Easiest: the output of `gh auth token`.
GITHUB_TOKEN=

# Comma-separated: owner/name@branch:deploy-workflow.yml (branch defaults to main;
# leave off :workflow to track commits only)
REPOS=creeperdiamonds/appealy@main:deploy-merged.yml

# The forum where changelog posts go (right-click the forum → Copy Channel ID)
CHANGELOG_FORUM_ID=

# Forums where every new post pings you, comma-separated (e.g. #bug-reports)
WATCH_FORUM_IDS=

# How often to check GitHub, in seconds (30 minimum)
POLL_SECONDS=60
